# Optional: enables TypeSafe Jev understanding. Without it, the heuristic fallback handles
# guard checks, slot detection and FAQ matching (less nuanced, but zero cost and no key needed).
TYPESAFE_API_KEY=

# Required in production, at least 32 characters. Signs the stateless session token.
# In development, a throwaway secret is generated automatically if this is unset.
CHAT_SESSION_SECRET=

# Optional: enables lead emails via Resend. Without it, leads are logged to the console.
RESEND_API_KEY=
LEAD_FROM_EMAIL=leads@example.com
LEAD_TO_EMAIL=owner@example.com

# debug | info | warn | error (default: info)
LOG_LEVEL=info
